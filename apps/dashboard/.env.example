# Environment for the dashboard process (apps/dashboard): UI, oRPC/OpenAPI
# routes, webhook ingress, and authentication, all on one origin (default port
# 3000, override with PORT).
#
# Copy to `apps/dashboard/.env`. Nuxt loads the `.env` sitting next to
# `nuxt.config.ts` on its own, for `nuxt dev`, `nuxt build`, and `nuxt preview`
# alike — no flag, and no file from the repository root. Real environment
# variables always win over the file, so a deployment sets them directly and
# ships no `.env` at all.
#
# The repository-root `.env.example` documents the `zero` CLI's own file and
# lists which section lives where.

# Model providers. Duplicated from the root `.env` (which configures the CLI)
# because the control plane hosted here executes runs in this process: the
# dashboard needs its own credentials rather than inheriting the CLI's. The root
# file annotates the subscription transports (AGENT_ZERO_ENABLE_*,
# AGENT_ZERO_CLAUDE_CODE_*, AGENT_ZERO_MODEL_FALLBACK_*); set them here too when
# this deployment should run them.
OPENAI_API_KEY=
AGENT_ZERO_MODEL=gpt-5
GITHUB_TOKEN=

# Control-plane API (packages/api), served at /rpc/** and /api/v1/**. Fails closed: without
# AGENT_ZERO_CONTROL_PLANE_TOKENS every mutation is rejected while reads stay open.
# Comma-separated name:token bearer credentials.
AGENT_ZERO_CONTROL_PLANE_TOKENS=
# Comma-separated repository paths tasks.create may target.
AGENT_ZERO_CONTROL_PLANE_REPOSITORIES=
# Comma-separated name:mode|mode execution-mode grants. Without a grant a principal may only
# request the non-writable observe and suggest modes.
AGENT_ZERO_CONTROL_PLANE_MODES=
# Comma-separated origins allowed to read /api/v1/** cross-origin via CORS. Empty by default:
# tasks.list/tasks.get/health are unauthenticated by design, so letting a browser read their
# responses from another origin is an explicit opt-in, not the default.
AGENT_ZERO_CONTROL_PLANE_ORIGINS=

GITHUB_WEBHOOK_SECRET=
# Checkout the webhook route binds incoming events to. POST /webhooks/github fails closed
# (503, nothing ingested) until both this and GITHUB_WEBHOOK_SECRET are set.
AGENT_ZERO_CHECKOUT_PATH=

# Database (packages/database). Owns the schema and the migrations; this app is the only process
# that opens it. The pre-split name AUTH_DATABASE_URL is still read when this is unset.
# `packages/database/.env` carries the same connection string for drizzle-kit: keep the two
# pointing at one database, or migrations and the running server disagree about which store they
# mean. `server/auth.config.ts` resolves this at module load, so an unset value fails the server on
# its first request rather than degrading quietly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_zero_auth

# Authentication (server/auth.config.ts), mounted in-process at /api/auth/**.
# Generate the secret with: openssl rand -base64 32
# Use the NUXT_-prefixed name: the module requires it in production and only falls back to
# BETTER_AUTH_SECRET in development.
NUXT_BETTER_AUTH_SECRET=
# Registration is closed unless this is exactly "true". Meant for a self-hosted, single-owner
# deployment: create your own account with this on, then flip it back to false so nobody else can
# register through email/password or GitHub. Invitations (AUTH_ENABLE_INVITATIONS) stay the way to
# admit more people afterward.
AUTH_ENABLE_SIGNUP=false
# Both halves are required before the GitHub button is offered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Organizations are off unless this is exactly "true". Enabling them requires a working mail
# transport below, because invitations are delivered by email.
AUTH_ENABLE_ORGANIZATIONS=false
# Whether any signed-in user may create an organization. Ignored while organizations are off.
AUTH_ALLOW_ORGANIZATION_CREATION=false
# Invitations are off unless this is exactly "true". Enabling them requires a working mail
# transport below: a private invitation's link is never shown to whoever created it, so email is
# the only path it travels. Independent of AUTH_ENABLE_SIGNUP — with registration closed they are
# the only way in, and with it open they grant roles and organization membership instead.
AUTH_ENABLE_INVITATIONS=false
# The RFC 8628 device flow, which is how `zero login` signs a terminal in. Off unless this is
# exactly "true": completing the flow mints a full session for a client that never sees the
# browser, so it is a deliberate grant rather than something an upgrade turns on. Applies the same
# way to a cloud-managed deployment and a self-hosted one; the CLI is pointed at either with
# `zero login --url <origin>` or AGENT_ZERO_URL.
#
# Also registers Better Auth's bearer plugin, which is the half that makes the flow's output
# usable: /device/token returns a session token, but session resolution reads the session cookie,
# so without it the CLI would hold a credential no request could present. The cost is that a
# leaked session token becomes replayable as a header, not only as a cookie — inherent to letting
# a browserless client hold a session at all, which is what this flag grants.
AUTH_ENABLE_DEVICE_AUTHORIZATION=false

# OAuth proxy, for preview and local deployments whose ephemeral origin cannot be registered as a
# provider callback URL. Both halves are required or the proxy stays off: the production origin the
# provider does have registered, and a key every participating environment shares. Deliberately its
# own secret rather than BETTER_AUTH_SECRET, which production and preview should not share — a
# leaked proxy key must not be able to forge sessions. Leave both empty in production.
OAUTH_PROXY_PRODUCTION_URL=
OAUTH_PROXY_SECRET=

# Better Auth's hosted infrastructure (@better-auth/infra). Cloud-managed deployments only: these
# are provisioned per project on Better Auth's service, so a self-hosted install leaves all three
# empty and neither plugin is registered. All three are required together or the capability stays
# off — a partially configured deployment would mount endpoints that fail on their first call.
#
# What turning this on means, beyond a feature:
#   - sentinel() scores sign-in and sign-up attempts (credential stuffing, impossible travel,
#     proof of work), which reports authentication events to a third party.
#   - dash() reports analytics and mounts ~79 endpoints under /api/auth/dash/**, including
#     execute-adapter, impersonate-user, delete-many-users, and export-users. All but two require
#     a short-lived JWT signed by the hosted service whose apiKeyHash claim also matches this
#     deployment's BETTER_AUTH_API_KEY.
#   - the two exceptions, accept-invitation and complete-invitation, are authorized by an
#     invitation token alone and create a user (emailVerified: true), a password account, and a
#     session. They bypass AUTH_ENABLE_SIGNUP and the Better Enrollment flow, so enabling dash()
#     delegates account creation to whoever can mint an invitation in the hosted console.
#   - the browser-side sentinel client identifies every visitor against BETTER_AUTH_KV_URL. It is
#     loaded only when these are set, because that call must not happen on a self-hosted install.
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=
BETTER_AUTH_API_KEY=

# Mail (packages/mail). "console" logs instead of delivering and is the default when neither a
# provider nor a Resend credential is configured, so an unconfigured deployment cannot silently
# attempt real delivery. A Vercel Resend integration that supplies RESEND_API_KEY selects Resend
# automatically when MAIL_PROVIDER is absent; an explicit provider always wins.
MAIL_PROVIDER=console
MAIL_FROM=noreply@example.com
# Required when MAIL_PROVIDER=resend.
RESEND_API_KEY=
# Required when MAIL_PROVIDER=smtp. SMTP_SECURE is implicit TLS: true on 465, false on 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Sign-in capabilities are derived from AUTH_ENABLE_SIGNUP and the GitHub OAuth credentials above
# at build time, so rebuild whenever those policy values change. NUXT_PUBLIC_SITE_URL is optional:
# the auth module auto-detects the base URL from the incoming request, and this only needs to be
# set for a custom domain or deterministic OAuth callbacks.
NUXT_PUBLIC_SITE_URL=
PORT=3000

# Deployment target, read at build time only: it selects the ViteHub deployment preset (see
# config/env.ts), which in turn fixes the Nitro preset the build emits and the KV driver task
# history resolves. Unset builds the self-hosted bundle in .output/; apps/dashboard/vercel.json
# sets NITRO_PRESET=vercel so a Vercel build writes .vercel/output instead. Accepted values are
# the Nitro preset each plan pins (vercel, node-server, cloudflare-module, deno-deploy,
# netlify); VITEHUB_HOSTING names the same target as a ViteHub plan (vercel, node, cloudflare,
# deno, netlify) and wins over NITRO_PRESET.
NITRO_PRESET=
VITEHUB_HOSTING=
# Read at runtime by the Upstash KV store a hosted preset resolves, because a serverless function
# has no writable filesystem to keep task history on. Unused by the self-hosted `node` preset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Build metadata (packages/build-env), published under runtimeConfig.public.buildInfo and read
# with useBuildInfo(). On Vercel every field is resolved from the platform's own VERCEL_GIT_*
# variables while the build runs, and none of these need to be set. Everywhere else — a container
# image built in CI, a self-hosted `node .output/server/index.mjs` — the build resolves what it
# can from the checkout and the server completes the rest from these at run time.
#
# Setting any of them takes precedence over every auto-detected provider, so a deployment can
# always state what it is rather than have it inferred.
AGENT_ZERO_BUILD_COMMIT=
AGENT_ZERO_BUILD_BRANCH=
AGENT_ZERO_BUILD_PR_NUMBER=
AGENT_ZERO_BUILD_URL=
AGENT_ZERO_BUILD_PRODUCTION_URL=
# One of dev, preview, canary, release. The one field no detection can work out for a self-hosted
# staging deployment, which is a preview in every way that matters to the people looking at it.
AGENT_ZERO_BUILD_ENV=
