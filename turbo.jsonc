{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "tooling/oxc/base.oxlintrc.json",
    "tooling/oxc/packages.oxlintrc.json",
    "tooling/oxc/apps.oxlintrc.json",
    "tooling/oxc/.oxfmtrc.json",
    "tools/oxlint/anti-slop/**",
    ".oxfmtignore",
    "scripts/tsdown.config.ts",
    "vitest.config.ts",
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "*.tsbuildinfo"],
    },
    "@agent-zero/dashboard#build": {
      "dependsOn": ["^build"],
      // NITRO_PRESET and VITEHUB_HOSTING select the deployment target (config/env.ts), which
      // fixes both the Nitro preset the build emits and the KV driver it resolves. Strict env mode
      // hides VITEHUB_HOSTING from `nuxt build` unless it is declared here, and declaring both
      // keeps the target in the cache key, so a self-hosted `node-server` build can never be
      // restored into a hosted one.
      "env": [
        "AUTH_ENABLE_SIGNUP",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "AUTH_ENABLE_ORGANIZATIONS",
        "NUXT_PUBLIC_SITE_URL",
        "NITRO_PRESET",
        "VITEHUB_HOSTING",
        // Read by packages/build-env to resolve what the build is (version, commit, branch,
        // deploy channel). Declared so strict env mode does not hide them from `nuxt build`, and
        // so the resolved metadata is part of the cache key: a bundle that reports the wrong
        // commit is worse than one that is rebuilt. Whatever a target leaves unset is completed
        // at boot by the module's server pass instead.
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_*",
        "VERCEL_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "NUXT_ENV_VERCEL_*",
        "NETLIFY",
        "CONTEXT",
        "BRANCH",
        "HEAD",
        "COMMIT_REF",
        "REVIEW_ID",
        "DEPLOY_PRIME_URL",
        "DEPLOY_URL",
        "URL",
        "CF_PAGES*",
        "GITHUB_ACTIONS",
        "GITHUB_REF",
        "GITHUB_REF_NAME",
        // Only set for a `pull_request` trigger, where `GITHUB_REF_NAME` is `<pr>/merge` rather
        // than a branch; packages/build-env prefers this one when both are present.
        "GITHUB_HEAD_REF",
        "GITHUB_SHA",
        "AGENT_ZERO_BUILD_*",
      ],
      // `.git/HEAD` and the ref it points at, so a build with no platform variables in scope —
      // where packages/build-env falls back to reading the checkout directly — still busts the
      // cache when the branch or commit changes; without them, switching branches onto an
      // identical tree could restore a cached bundle that reports the previous revision.
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.git/HEAD",
        "$TURBO_ROOT$/.git/refs/heads/**",
      ],
      // `.vercel/output/**` is where the `vercel` preset writes instead of `.output/`; both are
      // listed so a cache hit restores whichever bundle the resolved target produced.
      "outputs": [".output/**", ".vercel/output/**"],
    },
    "@agent-zero/marketing#build": {
      "dependsOn": ["^build"],
      // Declared because Turborepo's strict env mode would otherwise hide these from `nuxt build`,
      // leaving @nuxtjs/seo with no site origin and the dashboard link pointing at localhost.
      // NITRO_PRESET is declared so the deployment target is explicit and part of the cache key.
      // Nitro does auto-detect a host from the platform variables Turborepo passes through, but
      // those are not hashed, so a cached self-hosted build could otherwise be restored into one.
      "env": [
        "MARKETING_SITE_URL",
        "MARKETING_DASHBOARD_URL",
        "NITRO_PRESET",
        // Read by packages/build-env to resolve what the build is (version, commit, branch,
        // deploy channel). Declared so strict env mode does not hide them from `nuxt build`, and
        // so the resolved metadata is part of the cache key: a bundle that reports the wrong
        // commit is worse than one that is rebuilt. Whatever a target leaves unset is completed
        // at boot by the module's server pass instead.
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_*",
        "VERCEL_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "NUXT_ENV_VERCEL_*",
        "NETLIFY",
        "CONTEXT",
        "BRANCH",
        "HEAD",
        "COMMIT_REF",
        "REVIEW_ID",
        "DEPLOY_PRIME_URL",
        "DEPLOY_URL",
        "URL",
        "CF_PAGES*",
        "GITHUB_ACTIONS",
        "GITHUB_REF",
        "GITHUB_REF_NAME",
        // Only set for a `pull_request` trigger, where `GITHUB_REF_NAME` is `<pr>/merge` rather
        // than a branch; packages/build-env prefers this one when both are present.
        "GITHUB_HEAD_REF",
        "GITHUB_SHA",
        "AGENT_ZERO_BUILD_*",
      ],
      // `.git/HEAD` and the ref it points at, so a build with no platform variables in scope —
      // where packages/build-env falls back to reading the checkout directly — still busts the
      // cache when the branch or commit changes; without them, switching branches onto an
      // identical tree could restore a cached bundle that reports the previous revision.
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.git/HEAD",
        "$TURBO_ROOT$/.git/refs/heads/**",
      ],
      "outputs": [".output/**", ".vercel/output/**"],
    },
    "@agent-zero/docs#build": {
      "dependsOn": ["^build"],
      // The canonical architecture and provider references are pulled in from the
      // repository-root docs/ directory by the @include hook in nuxt.config.ts.
      "env": ["NUXT_APP_BASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../docs/*.md"],
      "outputs": [".output/**"],
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"],
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
    },
    "test:browser": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
    },
    "db:generate": {
      "cache": false,
      "outputs": [],
    },
    "db:migrate": {
      "cache": false,
      // Declared because Turborepo's strict env mode would otherwise hide the connection string
      // from drizzle-kit and silently migrate the local default instead.
      "env": ["DATABASE_URL", "AUTH_DATABASE_URL"],
      "outputs": [],
    },
    // Rewrites the checked-in render of every mail template (packages/mail). Uncached: it is run
    // deliberately after editing a template, and its output is a source file, not a build artifact.
    "mail:compile": {
      "cache": false,
      "outputs": [],
    },
    "i18n:check": {
      "cache": false,
      "outputs": [],
    },
    "i18n:report": {
      "cache": false,
      "outputs": [],
    },
    "i18n:schema": {
      "cache": false,
      "outputs": [],
    },
    "i18n:status": {
      "cache": false,
      "outputs": [],
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
    },
    "clean": {
      "cache": false,
    },
  },
}
