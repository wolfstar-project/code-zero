{
  "name": "@code-zero/cli",
  "version": "0.4.0",
  "bin": {
    "zero": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "tsc -b --clean",
    "lint": "oxlint --config ../../tooling/oxc/packages.oxlintrc.json --type-aware --type-check src",
    "lint:fix": "oxlint --fix --config ../../tooling/oxc/packages.oxlintrc.json --type-aware --type-check src",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc --project tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@bomb.sh/args": "^0.3.1",
    "@clack/prompts": "^1.7.0",
    "@code-zero/agent": "workspace:*",
    "@code-zero/config": "workspace:*",
    "@code-zero/models": "workspace:*",
    "@code-zero/runner": "workspace:*",
    "@code-zero/shared": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "^1.44.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
